{
  "name": "brewlite-monorepo",
  "version": "1.0.0",
  "description": "BrewLite - Cashless Coffee Ordering Application (Agile Scrum)",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend run test"
  },
  "keywords": [
    "brewlite",
    "coffee-ordering",
    "nestjs",
    "nextjs",
    "scrum"
  ],
  "author": "SWE Project Team",
  "license": "UNLICENSED"
}
