{
  "name": "brewlite-monorepo",
  "version": "1.0.0",
  "description": "BrewLite - Cashless Coffee Ordering Application (Agile Scrum)",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test": "npm run test:backend",
    "test:backend": "npm --prefix backend run test",
    "test:cov": "npm --prefix backend run test:cov",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix backend run typecheck"
  },
  "keywords": [
    "brewlite",
    "coffee-ordering",
    "nestjs",
    "nextjs",
    "scrum"
  ],
  "author": "SWE Project Team",
  "license": "UNLICENSED"
}
