@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12

start

:Receive order;

fork
    :Validate Order;
fork again
    :Validate Payment Information;
end fork

if () then ([Invalid order details])
    :Reject Order;
    stop
else ([Valid order details])
    :Process Payment;
    
    if () then ([Thẻ tín dụng\n(Credit card)])
        :Process credit card payment;
    elseif () then ([PayPal])
        :Process PayPal payment;
    else ([Chuyển khoản ngân hàng\n(Bank transfer)])
        :Process bank transfer payment;
    endif
    
    if () then ([Payment Failed])
        :Reject Order;
        stop
    else ([Payment Done])
        :Fulfill Order;
        :Shipping Order;
        
        if () then ([Shipping failed])
            :Reject Order;
            stop
        else ([Ship Success])
            :Complete order;
            stop
        endif
    endif
endif

@enduml
