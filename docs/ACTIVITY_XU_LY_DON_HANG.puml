@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12

|Khách hàng|
start
:Duyệt thực đơn & chọn đồ uống;
:Tùy biến kích cỡ (Size) và Topping;
:Thêm vào giỏ hàng;
:Xác nhận giỏ hàng & bấm Thanh toán;

|Giao diện Web (Next.js)|
:Gửi yêu cầu tạo đơn hàng;

|Backend API (NestJS)|
fork
    :Kiểm tra tính hợp lệ dữ liệu món & DTO;
fork again
    :Kiểm tra số lượng tồn kho nguyên liệu (Stock);
end fork

if () then ([Hết hàng hoặc dữ liệu không hợp lệ])
    |Giao diện Web (Next.js)|
    :Hiển thị thông báo lỗi & yêu cầu cập nhật giỏ hàng;
    stop
else ([Đủ tồn kho & dữ liệu hợp lệ])
    |Backend API (NestJS)|
    :Tạo bản ghi đơn hàng ở trạng thái PENDING;
    :Khởi tạo mã Idempotency-Key;

    |Giao diện Web (Next.js)|
    :Hiển thị tùy chọn phương thức thanh toán không tiền mặt;

    |Khách hàng|
    if () then ([Ví điện tử MoMo / ZaloPay])
        :Chọn thanh toán qua Ví điện tử;
    elseif () then ([Thẻ ngân hàng / Quét mã QR])
        :Chọn thanh toán qua Thẻ ngân hàng;
    else ([Ví thành viên BrewLite])
        :Chọn thanh toán bằng Ví thành viên;
    endif

    |Giao diện Web (Next.js)|
    :Gửi yêu cầu thanh toán (POST /payments);

    |Cổng thanh toán (Mock Gateway)|
    :Tiếp nhận và xử lý giao dịch trừ tiền;

    if () then ([Giao dịch thất bại hoặc người dùng hủy])
        |Backend API (NestJS)|
        :Cập nhật trạng thái đơn sang PAYMENT_FAILED;
        |Giao diện Web (Next.js)|
        :Thông báo lỗi thanh toán & giữ nguyên giỏ hàng;
        stop
    else ([Giao dịch thanh toán thành công])
        |Backend API (NestJS)|
        :Cập nhật trạng thái đơn sang PAID;
        :Trừ số lượng tồn kho (Optimistic Locking);
        
        if () then ([Đã đăng nhập tài khoản])
            :Tích lũy điểm thưởng thành viên;
        else ([Khách vãng lai])
            :Bỏ qua tích lũy điểm;
        endif

        fork
            |Giao diện Web (Next.js)|
            :Dọn sạch giỏ hàng;
            :Hiển thị Màn hình thành công kèm Mã nhận đồ uống (#1042);
        fork again
            |Nhân viên Barista|
            :Tiếp nhận đơn hàng mới tại quầy;
            :Chuyển trạng thái đơn sang PREPARING;
            :Tiến hành pha chế theo Size và Topping;
            :Chuyển trạng thái đơn sang READY;
            :Gọi mã nhận đồ uống tại quầy;
        end fork

        |Khách hàng|
        :Đối chiếu mã đơn và nhận đồ uống tại quầy;

        |Nhân viên Barista|
        :Xác nhận hoàn tất giao nước;

        |Backend API (NestJS)|
        :Cập nhật trạng thái đơn sang COMPLETED;
        stop
    endif
endif

@enduml
