classDiagram
    direction TB

    class User {
        +String id
        +String email
        +String passwordHash
        +String fullName
        +String phone
        +Role role
        +Int loyaltyPoints
        +DateTime createdAt
        +DateTime updatedAt
        +register()
        +login()
        +updateProfile()
    }

    class Product {
        +String id
        +String name
        +String description
        +Decimal basePrice
        +String imageUrl
        +ProductCategory category
        +Boolean isAvailable
        +Int stock
        +Int version
        +DateTime createdAt
        +DateTime updatedAt
        +checkStock(qty) Boolean
        +updateStock(delta)
    }

    class Order {
        +String id
        +String orderCode
        +String userId
        +OrderStatus status
        +Decimal totalAmount
        +Decimal discountAmount
        +Decimal finalAmount
        +String promotionId
        +String pickupCode
        +String notes
        +DateTime createdAt
        +DateTime updatedAt
        +calculateTotal() Decimal
        +applyPromotion(promo)
        +transitionTo(nextStatus)
    }

    class OrderItem {
        +String id
        +String orderId
        +String productId
        +Int quantity
        +Size selectedSize
        +String selectedToppings
        +Decimal unitPrice
        +Decimal subtotal
        +calculateSubtotal() Decimal
    }

    class Payment {
        +String id
        +String orderId
        +Decimal amount
        +PaymentMethod method
        +PaymentStatus status
        +String idempotencyKey
        +String transactionId
        +DateTime paidAt
        +DateTime createdAt
        +markSuccess(txId)
        +markFailed()
    }

    class Promotion {
        +String id
        +String code
        +Decimal discountPercent
        +Decimal maxDiscount
        +Decimal minOrderAmount
        +DateTime startDate
        +DateTime endDate
        +Boolean isActive
        +Int usageLimit
        +Int usedCount
        +isValid(orderAmount) Boolean
        +calculateDiscount(orderAmount) Decimal
    }

    class LoyaltyTransaction {
        +String id
        +String userId
        +String orderId
        +Int points
        +LoyaltyType type
        +Int balanceAfter
        +String description
        +DateTime createdAt
    }

    class Role {
        <<enumeration>>
        CUSTOMER
        BARISTA
        ADMIN
    }

    class ProductCategory {
        <<enumeration>>
        COFFEE
        TEA
        FREEZE
        PASTRY
    }

    class Size {
        <<enumeration>>
        SMALL
        MEDIUM
        LARGE
    }

    class OrderStatus {
        <<enumeration>>
        PENDING
        PAID
        PAYMENT_FAILED
        PREPARING
        READY
        COMPLETED
        CANCELLED
    }

    class PaymentMethod {
        <<enumeration>>
        MOMO
        VNPAY
        ZALOPAY
        CREDIT_CARD
        CASH
    }

    class PaymentStatus {
        <<enumeration>>
        PENDING
        SUCCESS
        FAILED
    }

    class LoyaltyType {
        <<enumeration>>
        EARN
        REDEEM
        EXPIRE
    }

    User "1" --> "0..*" Order : places
    User "1" --> "0..*" LoyaltyTransaction : owns
    Order "1" *-- "1..*" OrderItem : contains
    Product "1" <-- "0..*" OrderItem : references
    Order "1" --> "0..1" Payment : settled by
    Promotion "0..1" <-- "0..*" Order : applied to
    Order "0..1" --> "0..1" LoyaltyTransaction : triggers

    User ..> Role
    Product ..> ProductCategory
    OrderItem ..> Size
    Order ..> OrderStatus
    Payment ..> PaymentMethod
    Payment ..> PaymentStatus
    LoyaltyTransaction ..> LoyaltyType
