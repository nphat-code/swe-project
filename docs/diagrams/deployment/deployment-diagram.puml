@startuml deployment-diagram
title UML Deployment Diagram - Production Environment (AWS Ubuntu Architecture)

skinparam monochrome true
skinparam shadowing false
skinparam roundCorner 6
skinparam defaultTextAlignment center
skinparam defaultFontSize 12
skinparam ArrowFontSize 11

' ====================================================
' 1. CLIENT TIER & DEVOPS
' ====================================================
node "Client Device (Mobile / Desktop)" as clientDevice {
  node "Web Browser (Chrome / Safari / Edge / PWA)" as browser {
    component "User Interface\n(Next.js React 19)" as ui
    component "API Client\n(Axios / Fetch)" as apiClient
    ui -> apiClient : In-memory
  }
}

node "DevOps Workstation (Admin Machine)" as devopsNode {
  component "Terminal (SSH Client)\n[ssh -i key.pem ubuntu@IP]" as sshClient
  component "Git CLI\n[git push origin main]" as gitClient
}

' ====================================================
' 2. EXTERNAL CLOUD SERVICES & NETWORK
' ====================================================
cloud "Internet / Public Network" as internet

cloud "Domain Name System (DNS Provider)" as dnsCloud {
  component "DNS A-Record (sslip.io)\n(3.26.221.207.sslip.io -> 3.26.221.207)" as dnsRecord
}

cloud "GitHub Repository & Actions" as githubCloud {
  component "Git Remote & GHCR\n(nphat-code/swe-project)" as gitRemote
}

node "Payment Gateway Mock Service" as paymentService {
  component "Mock Payment Adapter\n(MoMo / VNPay / Card / Wallet)" as mockPay
}

' ====================================================
' 3. AWS CLOUD INFRASTRUCTURE (UBUNTU SERVER)
' ====================================================
cloud "AWS Cloud VPC (Region: ap-southeast-2 Sydney)" as awsCloud {

  node "AWS EC2 Virtual Machine Instance (Ubuntu 26.04 LTS)\n[Public IP: 3.26.221.207 | Domain: 3.26.221.207.sslip.io]" as ec2Instance {
    
    component "OpenSSH Server (sshd)\n[TCP Port 22]" as sshd
    component "Deploy Runner\n[docker compose -f docker-compose.prod.yml]" as gitPull
    artifact "Configuration & Secrets\n(.env, deploy/nginx/brewlite.conf, docker-compose.prod.yml)" as appConfig

    node "Web Server & Reverse Proxy" as nginxNode {
      component "Nginx Web Server + Certbot\n(Let's Encrypt SSL/TLS 1.3, Ports 80 & 443)" as nginx
    }

    package "Docker Container Runtime Engine (Docker Compose)" as dockerEngine {
      
      node "Container: frontend (brewlite_frontend_prod)" as webContainer {
        component "Next.js 16 Standalone Server\n[127.0.0.1:3000]" as nextjsApp
      }

      node "Container: backend (brewlite_backend_prod)" as apiContainer {
        component "NestJS 10 REST API Service\n[127.0.0.1:3001]" as nestjsApp
        component "Health Check Probe\n[GET /health -> SELECT 1]" as healthProbe
        component "Structured Logger\n(Stdout Stream)" as logger
      }

      node "Container: postgres (brewlite_postgres_prod)" as dbContainer {
        database "PostgreSQL 16 Alpine\n[Port 5432 (Internal Bridge Only)]" as pgEngine {
          storage "Persistent Docker Volume on AWS EBS\n(postgres_prod_data -> /var/lib/postgresql/data)" as ebsVolume
        }
      }
    }
  }
}

' ====================================================
' 4. CONNECTORS & PROTOCOLS
' ====================================================
' DNS resolution
browser ..> dnsRecord : 1. Resolve Domain\n(3.26.221.207.sslip.io)
dnsRecord ..> nginx : Maps to 3.26.221.207

' User traffic to Nginx
ui --> nginx : 2. HTTPS : 443 (Static Assets & HTML)
apiClient --> nginx : 2. HTTPS : 443 (REST API Requests)

' DevOps connections
gitClient --> gitRemote : Git Push (Code changes)
gitPull <.. gitRemote : Git Pull (Deploy code to server)
gitPull ..> appConfig : Apply config & .env
sshClient --> sshd : SSH (TCP Port 22)\nSecure Remote Management

' Nginx Reverse Proxy routing
nginx --> nextjsApp : Reverse Proxy\n(HTTP : 3000)
nginx --> nestjsApp : Reverse Proxy\n(HTTP : 3001)
nginx ..> healthProbe : Periodic Health Check\n(Every 30s)

' Database & External API
nestjsApp --> pgEngine : TCP / SQL (Port 5432)\nPrisma Connection Pool
nestjsApp --> mockPay : HTTPS (Outbound)\nPayment Verify & Callback

@enduml
