@startuml deployment-diagram
title UML Deployment Diagram - Local, CI/CD & Production (AWS EC2 Architecture)

skinparam monochrome true
skinparam shadowing false
skinparam roundCorner 6
skinparam defaultTextAlignment center
skinparam defaultFontSize 11
skinparam ArrowFontSize 10
skinparam nodesep 35
skinparam ranksep 40

' ====================================================
' 1. LOCAL ENVIRONMENT & CLIENT TIER
' ====================================================
frame "1. LOCAL DEVELOPMENT ENVIRONMENT" as localBoundary {
  node "Developer Workstation (Local Machine)" as devopsNode {
    component "Local Docker Compose\n(docker-compose.yml: :3000 / :3001 / :5432)" as localStack
    component "Git CLI\n[git push origin main]" as gitClient
    component "Terminal (SSH Client)\n[ssh -i brewlite-key.pem ubuntu@3.26.221.207]" as sshClient
  }
}

node "Client Device (Mobile / Desktop)" as clientDevice {
  node "Web Browser (Chrome / Safari / Edge / PWA)" as browser {
    component "User Interface\n(Next.js React 19)" as ui
    component "API Client\n(Fetch API)" as apiClient
    ui -> apiClient : In-memory
  }
}

cloud "Domain Name System (DNS Provider)" as dnsCloud {
  component "DNS A-Record (DuckDNS)\n(nphat-brewlite.duckdns.org -> 3.26.221.207)" as dnsRecord
}

' ====================================================
' 2. CI / CD ENVIRONMENT
' ====================================================
frame "2. CI / CD ENVIRONMENT (GitHub Cloud)" as ciBoundary {
  node "GitHub Repository & Actions" as githubCloud {
    component "Git Remote\n(nphat-code/swe-project)" as gitRemote
    component "CI Quality Gate\n(Lint, TypeCheck, Unit & E2E Tests, Build)" as ciRunner
    component "Container Registry (GHCR)\n& Docker Smoke Test" as ghcrRegistry
    component "CD SSH Deploy Job\n(cd.yml)" as cdJob
    gitRemote --> ciRunner : Trigger on Push
    ciRunner --> ghcrRegistry : Build & Tag Images
    ghcrRegistry --> cdJob : Pass Smoke Check
  }
}

' ====================================================
' 3. PRODUCTION ENVIRONMENT (AWS CLOUD)
' ====================================================
frame "3. PRODUCTION ENVIRONMENT (AWS Cloud VPC - ap-southeast-2 Sydney)" as prodBoundary {
  node "AWS EC2 Virtual Machine Instance (Ubuntu 26.04 LTS)\n[Public IP: 3.26.221.207 | Domain: nphat-brewlite.duckdns.org]" as ec2Instance {

    component "OpenSSH Server (sshd)\n[TCP Port 22]" as sshd
    component "Deploy Runner\n[docker compose -f docker-compose.prod.yml]" as gitPull
    artifact "Configuration & Secrets\n(.env, deploy/nginx/brewlite.conf, docker-compose.prod.yml)" as appConfig

    node "Web Server & Reverse Proxy" as nginxNode {
      component "Nginx Web Server + Certbot\n(Let's Encrypt SSL/TLS 1.3, Ports 80 & 443)" as nginx
    }

    package "Docker Container Runtime Engine (Docker Compose)" as dockerEngine {

      node "Container: frontend (brewlite_frontend_prod)" as webContainer {
        component "Next.js 16 Standalone Server\n[127.0.0.1:3000]" as nextjsApp
      }

      node "Container: backend (brewlite_backend_prod)" as apiContainer {
        component "NestJS 10 REST API Service\n[127.0.0.1:3001]" as nestjsApp
        component "Health Check Probe\n[GET /health -> SELECT 1]" as healthProbe
        component "Structured Logger\n(Stdout Stream)" as logger
      }

      node "Container: postgres (brewlite_postgres_prod)" as dbContainer {
        database "PostgreSQL 16 Alpine\n[127.0.0.1:5432 (SSH Tunnel / Docker Bridge)]" as pgEngine {
          storage "Persistent Docker Volume on AWS EBS\n(postgres_prod_data -> /var/lib/postgresql/data)" as ebsVolume
        }
      }
    }
  }
}

node "PayOS VietQR Payment Gateway" as paymentService {
  component "PayOS API & Webhook\n(api-merchant.payos.vn)" as payosGateway
}

' ====================================================
' 4. CONNECTORS & PROTOCOLS
' ====================================================
browser ..> dnsRecord : 1. Resolve Domain\n(nphat-brewlite.duckdns.org)
dnsRecord ..> nginx : Maps to 3.26.221.207

ui --> nginx : 2. HTTPS : 443 (Static Assets & HTML)
apiClient --> nginx : 2. HTTPS : 443 (REST API Requests)

gitClient --> gitRemote : Git Push (Code changes)
cdJob --> sshd : CD Deploy via SSH (Port 22)
gitPull <.. gitRemote : Git Pull (Sync source)
gitPull ..> appConfig : Apply .env & compose
sshClient --> sshd : SSH (Port 22) & Tunnel (:5433 -> :5432)

nginx --> nextjsApp : Reverse Proxy (HTTP : 3000)
nginx --> nestjsApp : Reverse Proxy (HTTP : 3001)
nginx ..> healthProbe : Health Check (Every 30s)

nestjsApp --> pgEngine : TCP / SQL (Port 5432)\nPrisma Connection Pool
nestjsApp --> payosGateway : HTTPS (Outbound)\nCreate VietQR & Sync Status
payosGateway ..> nginx : HTTPS : 443 (Webhook)\nPOST /api/payments/payos-webhook

@enduml
