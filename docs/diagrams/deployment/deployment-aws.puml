@startuml deployment-aws
title AWS Cloud Deployment Diagram (Ubuntu Server Architecture)

skinparam monochrome true
skinparam shadowing false
skinparam roundCorner 6
skinparam defaultTextAlignment center
skinparam defaultFontSize 12
skinparam ArrowFontSize 11

node "Client Device" as client {
  node "Web Browser" as browser {
    component "User Interface (Next.js SPA/SSR)" as ui
    component "API Client (Axios/Fetch)" as api
    ui -> api : In-memory
  }
}

node "DevOps / Admin Workstation" as devops {
  component "SSH Terminal Client\n(OpenSSH / PuTTY)" as sshClient
  component "Git Client" as gitLocal
}

cloud "Git Repository Host\n(GitHub / GitLab)" as gitHub

cloud "AWS Cloud VPC (Region: ap-southeast-1)" as awsCloud {

  node "AWS EC2 Instance (Ubuntu 22.04 LTS)" as ec2 {
    
    component "SSH Daemon (sshd)\n[Port 22]" as sshd
    component "Git CLI & Deploy Hook" as gitPull
    artifact "Config Files\n(.env, nginx.conf, docker-compose.yml)" as config
    
    node "Web Server & Reverse Proxy" as nginxNode {
      component "Nginx / ALB\n(Load Balancer & SSL Termination)" as lb
    }

    package "Docker Container Runtime" {
      node "Container: Frontend" as webContainer {
        component "Next.js Node Server\n[Port 3000]" as nextjs
      }
      
      node "Container: Backend API" as apiContainer {
        component "NestJS REST API Service\n[Port 3001]" as nestjs
      }
      
      node "Container: Database" as dbContainer {
        database "PostgreSQL 16 Engine\n[Port 5432]" as postgres {
          storage "Mounted SSD EBS Volume\n(/var/lib/postgresql/data)" as dbData
        }
      }
    }
  }
}

node "Load Generator" as lg {
  component "Performance & Stress Tester\n(Artillery / JMeter)" as loadTest
}

sshClient --> sshd : SSH (TCP Port 22)\nRemote Admin & Config
gitPull <.. gitHub : Git Pull / Clone Repo
gitPull ..> config : Generate / Update Config

api --> lb : HTTPS : 443 (API Calls)
ui --> lb : HTTPS : 443 (Page Loads)
loadTest --> lb : Injected HTTP/S Traffic

lb --> nextjs : Reverse Proxy (HTTP : 3000)
lb --> nestjs : Reverse Proxy (HTTP : 3001)
nestjs --> postgres : TCP Connection (Port 5432)

@enduml
