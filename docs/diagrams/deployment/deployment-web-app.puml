@startuml deployment-web-app
title Web Application Deployment Diagram (UML 2.0)

skinparam monochrome true
skinparam shadowing false
skinparam roundCorner 6
skinparam defaultTextAlignment center
skinparam defaultFontSize 12
skinparam ArrowFontSize 11

node "Client Device" as client {
  node "Web Browser" as browser {
    component "User Interface" as ui
    component "API Client" as api
    ui -> api : In-memory
  }
}

cloud "Internet / Cloud Network" as cloud

node "Load Generator" as lg {
  component "Traffic Simulator\n(Artillery / JMeter)" as sim
}

node "Load Balancer Host" as lbHost {
  component "Load Balancer\n(Nginx / HAProxy / ALB)" as lb
}

package "Application Server Tier" {
  node "Web Server 1 (Node.js/App)" as ws1 {
    component "Web Service Instance 1" as app1
  }
  node "Web Server 2 (Node.js/App)" as ws2 {
    component "Web Service Instance 2" as app2
  }
  node "Web Server 3 (Node.js/App)" as ws3 {
    component "Web Service Instance 3" as app3
  }
}

package "Persistence Tier" {
  node "Database Server Host" as dbHost {
    database "Database Server" as db {
      component "RDBMS Engine\n(PostgreSQL)" as dbEngine
    }
  }
}

api --> cloud : HTTPS (Port 443)
sim --> cloud : Injected Load
cloud --> lb : HTTPS (Port 443)

lb --> app1 : HTTP / Reverse Proxy
lb --> app2 : HTTP / Reverse Proxy
lb --> app3 : HTTP / Reverse Proxy

app1 --> dbEngine : TCP / SQL (Port 5432)
app2 --> dbEngine : TCP / SQL (Port 5432)
app3 --> dbEngine : TCP / SQL (Port 5432)

@enduml
