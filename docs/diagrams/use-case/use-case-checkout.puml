@startuml use-case-checkout
title SƠ ĐỒ USE CASE TRỌNG TÂM: ĐẶT VÀ THANH TOÁN ĐƠN HÀNG (BREWLITE)
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam packageStyle rectangle

actor "Khách hàng\n(Customer)" as Customer
actor "Khách thành viên\n(Member)" as Member
actor "Cổng thanh toán\n(MoMo / VNPay)" as PaymentGW

Member --|> Customer

rectangle "PHẠM VI TRỌNG TÂM: ĐẶT HÀNG & THANH TOÁN (BREWLITE)" {
    usecase "UC04: Quản lý giỏ hàng" as UC4
    usecase "UC05: Đặt hàng (Checkout)" as UC5
    usecase "UC05.1: Áp dụng mã Voucher" as UC5_1
    
    usecase "UC06: Thanh toán trực tuyến" as UC6
    usecase "UC06.1: Chọn phương thức Ví / Thẻ" as UC6_1
    usecase "UC06.2: Xử lý Idempotent & Trừ tiền" as UC6_2
    
    usecase "UC08: Nhận mã nước & Xem lịch sử đơn" as UC8
    usecase "UC09: Tích lũy điểm thưởng" as UC9
}

Customer -- UC4
Customer -- UC5
Customer -- UC8

UC5 ..> UC6 : <<include>>
UC5_1 ..> UC5 : <<extend>>

UC6 ..> UC6_1 : <<include>>
UC6 ..> UC6_2 : <<include>>
UC6_2 -- PaymentGW

UC5 ..> UC8 : <<include>>
UC9 ..> UC5 : <<extend>>
Member -- UC9
@enduml
